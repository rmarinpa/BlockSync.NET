{
  "openapi": "3.0.1",
  "info": {
    "title": "BlockSync.NET API",
    "description": "Motor de sincronización de datos con integridad basada en blockchain. Sincronización inteligente usando comparación de hashes inspirada en Merkle Trees.",
    "contact": {
      "name": "BlockSync.NET"
    },
    "version": "v1.0.0"
  },
  "paths": {
    "/api/ChileCompra/seed": {
      "post": {
        "tags": [
          "ChileCompra"
        ],
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 2025
            }
          },
          {
            "name": "maxRecords",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "clearFirst",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/ChileCompra/stats": {
      "get": {
        "tags": [
          "ChileCompra"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/ChileCompra/sync": {
      "post": {
        "tags": [
          "ChileCompra"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/ChileCompra/awards/{periodo}": {
      "get": {
        "tags": [
          "ChileCompra"
        ],
        "parameters": [
          {
            "name": "periodo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/ChileCompra/destination/clear": {
      "post": {
        "tags": [
          "ChileCompra"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/ChileCompra/destination/stats": {
      "get": {
        "tags": [
          "ChileCompra"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Sync/status": {
      "get": {
        "tags": [
          "Sync"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
